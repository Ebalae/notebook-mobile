{
  "expo": {
    "name": "Notebook",
    "slug": "notebook",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/notebook-icon-light.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "icon": {
        "light": "./assets/notebook-icon-light.png",
        "dark": "./assets/notebook-icon-dark.png"
      }
    },
    "android": {
      "package": "net.miroshnichenko.note",
      "versionCode": 5,
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "@react-native-community/datetimepicker",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F7F6F2",
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#F5C542"
        }
      ],
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "microphonePermission": false,
          "photosPermission": "Разрешите приложению добавлять фотографии в заметки."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Разрешите приложению сохранять фотографии в галерею.",
          "granularPermissions": [
            "photo"
          ]
        }
      ],
      "./plugins/withLocalizedAppName",
      "expo-secure-store",
      "expo-localization"
    ],
    "extra": {
      "eas": {
        "projectId": "d5345776-09ad-4250-b73c-e56347b04332"
      }
    }
  }
}
